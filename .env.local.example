# Clerk — get from https://dashboard.clerk.com after creating an app
# (API keys page → Quick Copy)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where Clerk's prebuilt components live in this app
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Convex — set automatically by `npx convex dev` on first run
NEXT_PUBLIC_CONVEX_URL=
# CONVEX_DEPLOYMENT will also be added by the CLI

# ----------------------------------------------------------------------
# The following is NOT a Next.js variable — do NOT set it here.
# It must be set on the Convex dashboard:
#   https://dashboard.convex.dev → your project → Settings → Environment Variables
# Value = your Clerk JWT template "Issuer" URL (see README step 3).
#
# CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-frontend-api.clerk.accounts.dev
# ----------------------------------------------------------------------
